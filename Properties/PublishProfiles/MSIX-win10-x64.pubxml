<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishDir>$(MSBuildProjectDirectory)\bin\publish\windows-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifierOverride>win-x64</RuntimeIdentifierOverride>
    <Platform>x64</Platform>
    <Configuration>Release</Configuration>
    <IntermediateOutputPath>obj\publish\windows-x64\$(ApplicationDisplayVersion).$(ApplicationVersion)\</IntermediateOutputPath>
    <OutputPath>bin\publish-build\windows-x64\$(ApplicationDisplayVersion).$(ApplicationVersion)\</OutputPath>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>True</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <PublishAppxPackage>true</PublishAppxPackage>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageDir>$(MSBuildProjectDirectory)\..\Publish\Windows\</AppxPackageDir>
  </PropertyGroup>
</Project>
