<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SmallBazar.ViewModels"
             xmlns:chatGpt="clr-namespace:SmallBazar.Services.ChatGpt"
             x:Class="SmallBazar.Views.ChatGptConnectionPage"
             x:DataType="viewModels:ChatGptConnectionViewModel"
             Title="ChatGPT account"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#171717}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="620" HorizontalOptions="Fill">
            <Label Text="ChatGPT account" FontSize="24" FontAttributes="Bold" />
            <Label Text="Connect your account and choose a model for AI Category Report. Saved reports remain available when you are offline or signed out." />
            <Label Text="Eligible ChatGPT Plus and Pro accounts can authorize plan usage. AI reports use your plan allowance or available credits. Review limits in ChatGPT Settings → Usage." />
            <Label Text="{Binding Account}" FontAttributes="Bold" />
            <Label Text="{Binding ConnectionStatus}" LineBreakMode="WordWrap" IsVisible="{Binding IsDiagnosticsVisible}" />
            <Picker Title="Saved ChatGPT accounts" ItemsSource="{Binding Accounts}" ItemDisplayBinding="{Binding Label, x:DataType=chatGpt:ChatGptAccount}"
                    SelectedItem="{Binding SelectedAccount}" IsEnabled="{Binding IsIdle}" />
            <Button Text="Use selected account" Command="{Binding UseAccountCommand}" IsEnabled="{Binding IsIdle}" />
            <Button Text="Continue with ChatGPT" Command="{Binding SignInCommand}" IsEnabled="{Binding IsIdle}"
                    BackgroundColor="{AppThemeBinding Light=Black, Dark=White}"
                    TextColor="{AppThemeBinding Light=White, Dark=Black}" />
            <Button Text="Add another account or workspace" Command="{Binding AddAccountCommand}" IsEnabled="{Binding IsIdle}" />
            <Label Text="{Binding SavedModelStatus}" FontAttributes="Bold" LineBreakMode="WordWrap" />
            <Button Text="Load available models" Command="{Binding LoadModelsCommand}" IsEnabled="{Binding IsIdle}" />
            <Picker Title="Report model" ItemsSource="{Binding Models}" ItemDisplayBinding="{Binding DisplayName, x:DataType=chatGpt:ChatGptModel}"
                    SelectedItem="{Binding SelectedModel}" IsEnabled="{Binding IsIdle}" />
            <Button Text="Use selected model for reports" Command="{Binding UseModelCommand}" IsEnabled="{Binding IsIdle}" />
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsDiagnosticsVisible}">
                <Label Text="Development diagnostics. Synthetic tests use your plan allowance or available credits." />
                <Button Text="Run one synthetic test" Command="{Binding TestCommand}" IsEnabled="{Binding IsIdle}" />
                <Button Text="Check report with synthetic boxes" Command="{Binding ReportCheckCommand}" IsEnabled="{Binding IsIdle}" />
                <Button Text="View saved synthetic report" Clicked="ViewSyntheticReportClicked" IsEnabled="{Binding IsIdle}" />
            </VerticalStackLayout>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Status}" LineBreakMode="WordWrap" />
            <Button Text="Cancel operation" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
            <Button Text="ChatGPT usage and access" Command="{Binding OpenUsageCommand}" />
            <Button Text="Sign out" Command="{Binding SignOutCommand}" IsEnabled="{Binding IsIdle}" />
            <Button Text="Close" Clicked="CloseClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
