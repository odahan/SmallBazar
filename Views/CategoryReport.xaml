<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmallBazar.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="SmallBazar.Views.CategoryReport"
             x:DataType="vm:CategoryReportViewModel" Title="AI Category Report">
    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
        <VerticalStackLayout Padding="10" Spacing="4">
            <Label Text="{Binding Status}" LineBreakMode="WordWrap" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Cancel analysis" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
        <WebView BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#171717}" x:Name="ReportWebView" Grid.Row="1" HorizontalOptions="Fill" VerticalOptions="Fill" />
        <HorizontalStackLayout Grid.Row="2" Spacing="10" Padding="10" HorizontalOptions="Center">
            <Button Text="Close" Clicked="OnCloseClicked" />
            <Button Text="Export" Clicked="OnExportClicked" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            <Button Text="Refresh" Command="{Binding RefreshCommand}" IsVisible="{Binding IsAnalysisAvailable}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
